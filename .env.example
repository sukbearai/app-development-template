# Local development only. Shell values override .env.local, then .env.
APP_NAME="Pstack App"
APP_ORIGIN="http://localhost:3100"
LOG_LEVEL=info
SESSION_COOKIE_NAME=pstack_session
SESSION_TTL_SECONDS=86400
RATE_LIMIT_DRIVER=memory
LOGIN_RATE_LIMIT_MAX=20
LOGIN_RATE_LIMIT_GLOBAL_MAX=200
WEB_REPLICAS=1
LOGIN_RATE_LIMIT_WINDOW_SECONDS=60
LOGIN_RATE_LIMIT_MEMORY_MAX_KEYS=5000
# Set real generated credentials before using shared environments.
POSTGRES_USER=app
POSTGRES_PASSWORD=local-development-only
POSTGRES_DB=app
POSTGRES_PORT=55432
DATABASE_URL=postgres://app:local-development-only@localhost:55432/app
POSTGRES_TOOLS=docker
POSTGRES_TOOL_IMAGE=postgres:17-alpine
WEB_PORT=3100
UPLOAD_STORAGE_DRIVER=local
UPLOAD_STORAGE_DIR=.uploads
UPLOAD_MAX_BYTES=10485760
REDIS_PORT=56379
REDIS_URL=redis://localhost:56379
KAFKA_PORT=59092
KAFKA_BROKERS=localhost:59092
COMPOSE_KAFKA_BROKERS=kafka:9092
KAFKA_CLIENT_ID=pstack
KAFKA_CONSUMER_GROUP_ID=pstack-worker
KAFKA_SECURITY_PROTOCOL=PLAINTEXT
# SSL/SASL_SSL use system trust unless a CA file is supplied. Certificate and key must be paired.
KAFKA_SSL_CA_FILE=
KAFKA_SSL_CERT_FILE=
KAFKA_SSL_KEY_FILE=
KAFKA_SASL_MECHANISM=
KAFKA_SASL_USERNAME=
KAFKA_SASL_PASSWORD=
ASYNC_RUNTIME_TOPICS=app.tasks,telemetry.events,files.events,audit.events
OUTBOX_PUBLISHER=dry-run
OUTBOX_BATCH_SIZE=10
# Read by the Web producer when creating events; existing events keep their policy.
OUTBOX_MAX_ATTEMPTS=5
OUTBOX_RETRY_BASE_MS=1000
OUTBOX_RETRY_MAX_MS=300000
OUTBOX_POLL_INTERVAL_MS=5000
OUTBOX_STALE_LOCK_MS=300000
MINIO_API_PORT=59000
MINIO_CONSOLE_PORT=59001
MINIO_ROOT_USER=localadmin
MINIO_ROOT_PASSWORD=local-development-only
OBJECT_STORAGE_ENDPOINT=http://localhost:59000
OBJECT_STORAGE_REGION=us-east-1
OBJECT_STORAGE_ACCESS_KEY=localadmin
OBJECT_STORAGE_SECRET_KEY=local-development-only
OBJECT_STORAGE_BUCKET=app-files
OBJECT_STORAGE_FORCE_PATH_STYLE=true
CLICKHOUSE_HTTP_PORT=58123
CLICKHOUSE_PASSWORD=local-development-only
CLICKHOUSE_URL=http://app:local-development-only@localhost:58123/app_analytics
LOCAL_STORAGE_TTL_HOURS=72
