{
  "name": "@pstack/web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vinext dev --port 3100",
    "build": "vinext build",
    "start": "node scripts/start.mjs",
    "lint": "pnpm -w lint",
    "typecheck": "tsc -p tsconfig.check.json --noEmit",
    "api:docs": "tsx scripts/generate-openapi.mjs",
    "contract:check": "tsx scripts/contract-check.mjs",
    "test:unit": "tsx --test tests/unit/*.test.mjs",
    "test:e2e": "node ../../scripts/verify-app.mjs",
    "test:ui": "node ../../scripts/verify-app.mjs --ui",
    "smoke": "node scripts/smoke.mjs",
    "test": "pnpm test:unit"
  },
  "dependencies": {
    "@pstack/contracts": "workspace:*",
    "@tanstack/react-query": "5.102.8",
    "drizzle-orm": "0.45.2",
    "lucide-react": "0.469.0",
    "pg": "8.21.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "recharts": "3.10.1",
    "zod": "4.4.3",
    "react-server-dom-webpack": "19.2.8",
    "vinext": "1.0.0-beta.9",
    "@pstack/server": "workspace:*",
    "@pstack/database": "workspace:*",
    "redis": "5.8.2",
    "@aws-sdk/client-s3": "3.922.0",
    "kafkajs": "2.2.4"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@types/node": "26.4.1",
    "@types/pg": "8.20.0",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.7",
    "drizzle-kit": "0.31.10",
    "tsx": "4.21.0",
    "typescript": "5.9.3",
    "@tailwindcss/postcss": "4.3.3",
    "@vitejs/plugin-react": "6.1.1",
    "@vitejs/plugin-rsc": "0.5.34",
    "tailwindcss": "4.3.3",
    "vite": "8.2.2"
  }
}
