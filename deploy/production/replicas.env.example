# Provision credentials before use. These placeholders intentionally fail preflight.
NODE_ENV=production
APP_ORIGIN=https://app.example.com
DATABASE_URL=postgresql://app:replace-me@postgres.internal:5432/app?sslmode=verify-full
SESSION_COOKIE_SECURE=true
WEB_REPLICAS=2
RATE_LIMIT_DRIVER=redis
REDIS_URL=rediss://app:replace-me@redis.internal:6379
UPLOAD_STORAGE_DRIVER=s3
OBJECT_STORAGE_ENDPOINT=https://objects.example.com
OBJECT_STORAGE_REGION=us-east-1
OBJECT_STORAGE_ACCESS_KEY=replace-me
OBJECT_STORAGE_SECRET_KEY=replace-me
OBJECT_STORAGE_BUCKET=app-files
OBJECT_STORAGE_FORCE_PATH_STYLE=true
UPLOAD_MAX_BYTES=10485760
UPLOAD_MAX_CONCURRENT=2
METRICS_TOKEN=replace-me
WEB_SHUTDOWN_TIMEOUT_MS=30000
WEB_STOP_GRACE_PERIOD=40s
WORKER_SHUTDOWN_TIMEOUT_MS=30000
WORKER_STOP_GRACE_PERIOD=40s
# Set on the Worker and use ASYNC_RUNTIME_PUBLISHER=kafka for Web diagnostics.
OUTBOX_PUBLISHER=kafka
KAFKA_BROKERS=kafka.internal:9093
KAFKA_SECURITY_PROTOCOL=SASL_SSL
KAFKA_SASL_MECHANISM=scram-sha-512
KAFKA_SASL_USERNAME=app
KAFKA_SASL_PASSWORD=replace-me
# Optional private CA: mount read-only and grant the application UID read access.
# KAFKA_SSL_CA_FILE=/run/secrets/kafka-ca.pem
