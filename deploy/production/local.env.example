# Provision credentials before use. These placeholders intentionally fail preflight.
NODE_ENV=production
APP_ORIGIN=https://app.example.com
DATABASE_URL=postgresql://app:replace-me@postgres.internal:5432/app?sslmode=verify-full
SESSION_COOKIE_SECURE=true
WEB_REPLICAS=1
RATE_LIMIT_DRIVER=memory
UPLOAD_STORAGE_DRIVER=local
# Mount durable storage here and grant the application UID write access.
UPLOAD_STORAGE_DIR=/srv/pstack/uploads
UPLOAD_STORAGE_SHARED=false
UPLOAD_MAX_BYTES=10485760
UPLOAD_MAX_CONCURRENT=2
METRICS_TOKEN=replace-me
WEB_SHUTDOWN_TIMEOUT_MS=30000
WEB_STOP_GRACE_PERIOD=40s
# No worker delivery is enabled by this single-Web example.
OUTBOX_PUBLISHER=disabled
