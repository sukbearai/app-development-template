{
  "name": "pstack-x",
  "version": "0.2.3",
  "private": true,
  "type": "module",
  "description": "Reusable full-stack application template.",
  "scripts": {
    "dev": "node scripts/with-env.mjs pnpm --filter @pstack/web dev",
    "build": "pnpm --filter @pstack/web build",
    "start": "node scripts/with-env.mjs pnpm --filter @pstack/web start",
    "backup:create": "node scripts/db-backup.mjs create",
    "backup:verify": "node scripts/db-backup.mjs verify",
    "backup:restore": "node scripts/db-backup.mjs restore",
    "db:generate": "node scripts/with-env.mjs pnpm --filter @pstack/database db:generate",
    "db:migrate": "node scripts/with-env.mjs pnpm --filter @pstack/database db:migrate",
    "db:integration": "node scripts/with-env.mjs pnpm --filter @pstack/database db:integration",
    "bootstrap:local": "pnpm local:up && pnpm db:migrate",
    "lint": "oxlint --config .oxlintrc.json --disable-nested-config --report-unused-disable-directives-severity error .",
    "typecheck": "pnpm -r --if-present typecheck",
    "api:docs": "pnpm --filter @pstack/web api:docs",
    "config:check": "node scripts/with-env.mjs pnpm --filter @pstack/server config:check",
    "production:check": "node scripts/with-env.mjs pnpm --filter @pstack/server config:check --deployment",
    "monitor:check": "node scripts/monitor-check.mjs",
    "test:capacity": "node scripts/verify-app.mjs --production --capacity",
    "storage:cleanup": "node scripts/with-env.mjs pnpm --filter @pstack/server storage:cleanup",
    "migration:check": "node scripts/with-env.mjs pnpm --filter @pstack/database migration:check",
    "contract:check": "pnpm --filter @pstack/web contract:check",
    "test:unit": "pnpm --filter @pstack/contracts test:unit && pnpm --filter @pstack/kafka test:unit && pnpm --filter @pstack/database test:unit && pnpm --filter @pstack/server test:unit && pnpm --filter @pstack/web test:unit && pnpm --filter @pstack/worker test:unit && pnpm test:sdk",
    "test:integration": "pnpm --filter @pstack/database test:integration && pnpm --filter @pstack/server test:integration && pnpm --filter @pstack/worker test:integration",
    "test:e2e": "node scripts/verify-app.mjs",
    "test:ui": "node scripts/verify-app.mjs --ui",
    "pr:verify": "node scripts/pr-verify.mjs",
    "smoke": "pnpm --filter @pstack/web smoke",
    "test": "pnpm test:unit && pnpm test:integration",
    "verify": "node scripts/pr-verify.mjs --template",
    "local:init": "node scripts/local.mjs init",
    "local:up": "node scripts/local.mjs up",
    "local:down": "node scripts/local.mjs down",
    "local:status": "node scripts/local.mjs status",
    "local:logs": "node scripts/local.mjs logs",
    "admin:bootstrap": "node scripts/with-env.mjs pnpm --filter @pstack/server admin:bootstrap",
    "template:init": "node scripts/template-init.mjs",
    "test:tools": "node --test scripts/tests/*.test.mjs",
    "test:backup": "node scripts/test-backup.mjs",
    "test:production": "node scripts/verify-app.mjs --production",
    "dependency:check": "node scripts/check-dependencies.mjs",
    "boundary:check": "node scripts/check-boundaries.mjs",
    "db:migrate:legacy": "node scripts/with-env.mjs pnpm --filter @pstack/database db:migrate:legacy",
    "test:containers": "node scripts/test-containers.mjs",
    "admin:recover": "node scripts/with-env.mjs pnpm --filter @pstack/server admin:recover",
    "app:backup:create": "node scripts/app-backup.mjs create",
    "app:backup:verify": "node scripts/app-backup.mjs verify",
    "app:backup:restore": "node scripts/app-backup.mjs restore",
    "test:app-backup": "node scripts/test-app-backup.mjs",
    "history:prune": "node --import tsx scripts/history-prune.mjs",
    "storage:resolve": "node --import tsx scripts/resolve-upload.mjs",
    "test:kafka-security": "node scripts/test-kafka-security.mjs",
    "test:async-recovery": "node scripts/test-async-recovery.mjs",
    "test:ui:production": "node scripts/verify-app.mjs --production --ui",
    "duplication:check": "node scripts/check-duplication.mjs",
    "duplication:baseline": "node scripts/check-duplication.mjs --update-baseline",
    "test:anti-slop": "node --import tsx --test tools/anti-slop/src/rules/*.test.ts tools/anti-slop/src/effect/rules/*.test.ts",
    "test:quality": "node --test scripts/tests/quality-gates.test.mjs",
    "hooks:install": "node scripts/install-hooks.mjs",
    "test:hooks": "node --test scripts/tests/git-hooks.test.mjs",
    "version:check": "node scripts/release-version-check.mjs",
    "capacity:compare": "node scripts/capacity-compare.mjs",
    "docs:check": "node scripts/check-docs.mjs",
    "test:cold-start": "node scripts/cold-start.mjs",
    "release:manifest": "node scripts/release-manifest.mjs",
    "release:plan": "node scripts/release-deploy.mjs plan",
    "release:publish": "node scripts/release-publish.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "sdk:generate": "pnpm api:docs && node scripts/generate-sdk.mjs",
    "sdk:check": "pnpm contract:check && node scripts/generate-sdk.mjs --check",
    "test:sdk": "pnpm --filter @pstack/sdk test:unit",
    "storybook": "pnpm --filter @pstack/web storybook",
    "storybook:build": "pnpm --filter @pstack/web storybook:build",
    "storybook:test": "pnpm --filter @pstack/web storybook:test",
    "storybook:smoke": "pnpm storybook:build && pnpm --filter @pstack/web storybook:smoke",
    "test:tracing-collector": "pnpm --filter @pstack/server test:tracing-collector",
    "tooling:upstream:check": "node scripts/check-tooling-upstream.mjs",
    "supply-chain:check": "node scripts/check-supply-chain.mjs",
    "security:audit": "pnpm audit --prod --audit-level high",
    "test:release-permissions": "node scripts/test-scanner-permissions.mjs",
    "release:scan": "node scripts/release-security.mjs",
    "release:apply": "node scripts/release-deploy.mjs apply",
    "release:rollback": "node scripts/release-deploy.mjs rollback",
    "release:resume": "node scripts/release-deploy.mjs resume",
    "release:status": "node scripts/release-deploy.mjs status",
    "monitor:tick": "node scripts/monitor-tick.mjs",
    "monitor:status": "node scripts/monitor-tick.mjs --status",
    "test:monitor-collector": "node scripts/test-monitor-collector.mjs",
    "test:deployment": "node scripts/test-deployment-compose.mjs",
    "test:deployment:slots": "node scripts/test-deployment-slots.mjs",
    "release:prove-rollback": "node scripts/release-rollback-proof.mjs"
  },
  "packageManager": "pnpm@11.26.0",
  "engines": {
    "node": ">=22.13"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.11.1",
    "@oxlint/plugins": "1.78.0",
    "@playwright/test": "1.63.0",
    "@trpc/client": "11.18.0",
    "@types/pg": "8.20.0",
    "dpdm": "4.3.0",
    "jscpd": "5.1.2",
    "openapi-typescript": "7.13.0",
    "oxlint": "1.78.0",
    "prettier": "3.9.6",
    "release-please": "17.3.0",
    "typescript": "5.9.3"
  },
  "dependencies": {
    "tsx": "4.23.13",
    "pg": "8.21.0",
    "zod": "4.4.3"
  }
}
