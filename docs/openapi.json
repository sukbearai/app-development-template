                          "processing",
                          "failed",
                          "deadLetter",
                          "published",
                          "oldestPendingAgeMs",
                          "staleLocks"
                        ],
                        "additionalProperties": false
                      },
                      "tasks": {
                        "type": "object",
                        "properties": {
                          "pending": {
                            "type": "integer",
                            "minimum": 0,
                            "maximum": 9007199254740991
                          },
                          "running": {
                            "type": "integer",
                            "minimum": 0,
                            "maximum": 9007199254740991
                          },
                          "succeeded": {
                            "type": "integer",
                            "minimum": 0,
                            "maximum": 9007199254740991
                          },
                          "failed": {
                            "type": "integer",
                            "minimum": 0,
                            "maximum": 9007199254740991
                          },
                          "deadLetter": {
                            "type": "integer",
                            "minimum": 0,
                            "maximum": 9007199254740991
                          },
                          "canceled": {
                            "type": "integer",
                            "minimum": 0,
                            "maximum": 9007199254740991
                          },
                          "oldestUnfinishedAgeMs": {
                            "type": "number",
                            "minimum": 0
                          }
                        },
                        "required": [
                          "pending",
                          "running",
                          "succeeded",
                          "failed",
                          "deadLetter",
                          "canceled",
                          "oldestUnfinishedAgeMs"
                        ],
                        "additionalProperties": false
                      },
                      "quarantine": {
                        "type": "object",
                        "properties": {
                          "message": {
                            "type": "integer",
                            "minimum": 0,
                            "maximum": 9007199254740991
                          },
                          "recovery": {
                            "type": "integer",
                            "minimum": 0,
                            "maximum": 9007199254740991
                          }
                        },
                        "required": [
                          "message",
                          "recovery"
                        ],
                        "additionalProperties": false
                      },
                      "uploads": {
                        "type": "object",
                        "properties": {
                          "pending": {
                            "type": "integer",
                            "minimum": 0,
                            "maximum": 9007199254740991
                          },
                          "writing": {
                            "type": "integer",
                            "minimum": 0,
                            "maximum": 9007199254740991
                          },
                          "cleanup": {
                            "type": "integer",
                            "minimum": 0,
                            "maximum": 9007199254740991
                          },
                          "blocked": {
                            "type": "integer",
                            "minimum": 0,
                            "maximum": 9007199254740991
                          }
                        },
                        "required": [
                          "pending",
                          "writing",
                          "cleanup",
                          "blocked"
                        ],
                        "additionalProperties": false
                      }
                    },
                    "required": [
                      "status",
                      "observedAt",
                      "outbox",
                      "tasks",
                      "quarantine",
                      "uploads"
                    ],
                    "additionalProperties": false
                  },
                  {
                    "type": "object",
                    "properties": {
                      "status": {
                        "type": "string",
                        "const": "unavailable"
                      },
                      "observedAt": {
                        "type": "string",
                        "format": "date-time",
                        "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z))$"
                      }
                    },
                    "required": [
                      "status",
                      "observedAt"
                    ],
                    "additionalProperties": false
                  }
                ]
              }
            },
            "required": [
              "version",
              "observedAt",
              "process",
              "databasePool",
              "uploads",
              "http",
              "database"
            ],
            "additionalProperties": false
          },
          "meta": {
            "type": "object",
            "propertyNames": {
              "type": "string"
            },
            "additionalProperties": {}
          }
        },
        "required": [
          "traceId",
          "data"
        ],
        "additionalProperties": false
      },
      "HealthSuccess": {
        "type": "object",
        "properties": {
          "traceId": {
            "type": "string",
            "minLength": 1
          },
          "data": {
            "type": "object",
            "properties": {
              "status": {
                "type": "string",
                "enum": [
                  "ok",
                  "degraded"
                ]
              },
              "service": {
                "type": "string",
                "minLength": 1
              },
